<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quick_capture_widget_background"
    tools:ignore="UnusedResources">

    <TextView
        android:id="@+id/quick_capture_widget_error_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/quick_capture_widget_unavailable"
        android:textColor="@color/quick_capture_widget_muted" />
</FrameLayout>
