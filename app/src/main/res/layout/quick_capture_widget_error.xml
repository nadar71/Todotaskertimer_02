<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quick_capture_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="UnusedResources">

    <TextView
        android:id="@+id/quick_capture_widget_error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/quick_capture_widget_unavailable"
        android:textColor="@color/quick_capture_widget_muted" />

    <Button
        android:id="@+id/quick_capture_widget_error_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/quick_capture_widget_retry_description"
        android:text="@string/quick_capture_widget_retry" />
</LinearLayout>
